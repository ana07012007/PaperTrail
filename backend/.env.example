PORT=5000
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/papertrail?retryWrites=true&w=majority
# Any long random string
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=251048569075-cjsi8jf3v39dka3t5mb0q2mmac09cq20.apps.googleusercontent.com

AI_SERVICE_URL=http://127.0.0.1:8000
# Must match AI_SERVICE_KEY in ai-service/.env
AI_SERVICE_KEY=change-me-to-a-random-string

CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# Which email domains can sign up. Empty = major providers only (Gmail, Outlook, Yahoo, iCloud, …
# plus gla.ac.in; full list in src/utils/email.js). "*" = any real, non-disposable domain.
# Or a comma-separated list, e.g. ALLOWED_EMAIL_DOMAINS=gla.ac.in,gmail.com
ALLOWED_EMAIL_DOMAINS=
